{
  "expo": {
    "name": "N'apsak?",
    "slug": "napsak-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.getnapsak",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "N'apsak, yakındaki önerileri sıralamak için konumunu kullanır."
      }
    },
    "android": {
      "package": "com.getnapsak",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "N'apsak, yakındaki önerileri sıralamak için konumunu kullanır."
        }
      ],
      "@sentry/react-native/expo"
    ],
    "extra": {
      "eas": {
        "projectId": "af043dd8-412f-403e-81c3-6e0af8e024d6"
      }
    },
    "owner": "napsaks-team"
  }
}
