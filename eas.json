{
  "cli": {
    "version": ">= 24.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_SERVICE_TIER": "local",
        "NAPSAK_BUILD_MODE": "local"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_SERVICE_TIER": "local",
        "NAPSAK_BUILD_MODE": "local"
      }
    },
    "connected-beta": {
      "distribution": "internal",
      "environment": "beta",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_SERVICE_TIER": "beta",
        "NAPSAK_BUILD_MODE": "connected"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_SERVICE_TIER": "production",
        "NAPSAK_BUILD_MODE": "connected"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
