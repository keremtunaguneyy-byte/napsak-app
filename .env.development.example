EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_FIREBASE_API_KEY=replace-with-dev-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-dev-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace-with-dev-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-dev-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-dev-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=replace-with-dev-app-id

# Optional. For a physical Android device this must be a host the phone can reach.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.10:8080
