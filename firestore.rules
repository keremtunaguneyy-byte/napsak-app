rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUserState() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'saved', 'dismissed', 'interests',
          'deviceMigrationVersion', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.deviceMigrationVersion == 1
        && data.saved is list && data.saved.size() <= 500
        && data.dismissed is list && data.dismissed.size() <= 500
        && data.interests is list && data.interests.size() <= 5
        && data.updatedAt is timestamp;
    }

    match /cities/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /catalogMeta/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /places/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /experiences/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /events/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /ideas/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /guides/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && validUserState();
      allow delete: if owns(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
