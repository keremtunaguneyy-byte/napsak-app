EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SERVICE_TIER=beta
NAPSAK_BUILD_MODE=connected
EXPO_PUBLIC_FIREBASE_API_KEY=replace-with-beta-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-beta-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace-with-beta-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=replace-with-beta-app-id
EXPO_PUBLIC_SENTRY_DSN=replace-with-beta-sentry-dsn

# Build-time only. Keep SENTRY_AUTH_TOKEN in EAS secret storage.
SENTRY_ORG=replace-with-sentry-organization
SENTRY_PROJECT=replace-with-beta-sentry-project
SENTRY_AUTH_TOKEN=replace-with-secret-build-token
